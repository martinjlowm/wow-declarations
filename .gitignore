# Yarn
.yarn/*
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
.pnp.*

*.tgz
.log/

dist/

mocks/**/*.js

# The root node_modules is a symlink to toolkit/node_modules created by
# toolkit/scripts/ensure-root-modules.mjs so the release tsconfigs resolve types.
# The toolkit's own artifacts (node_modules, .yarn state, devenv) are ignored by
# toolkit/.gitignore.
/node_modules
